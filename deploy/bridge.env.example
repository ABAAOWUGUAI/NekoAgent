# Copy outside the repository and replace paths for this deployment.
LISTEN_HOST=127.0.0.1
LISTEN_PORT=18777
TOKEN_PATH=./var/secrets/admin-token
CHANNEL_TOKEN_PATH=./var/secrets/channel-token
ASSISTANT_DB_PATH=./var/assistant.sqlite3
TASK_DB_PATH=./var/tasks.sqlite3
TASK_HISTORY_PATH=./var/tasks.jsonl
PROVIDER_SECRET_DIR=./var/provider-secrets
WORKSPACE_BASE=./workspace
DEFAULT_CWD=./workspace
CODEX_EXECUTOR_WORKSPACE_ROOT=./workspace
AGENT_BACKUP_ROOT=./var/backups
ARTIFACT_STORAGE_ROOT=./var/artifacts
OPS_BROKER_REQUIRED=0
ALLOW_PUBLIC_TOKEN_AUTH=0
ADMIN_COOKIE_SECURE=1

# Do not put Token values, Provider keys or Codex credentials in this file.
